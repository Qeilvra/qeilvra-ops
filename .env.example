# Copy to the repository root .env for local development only.
# Production/CI inject environment variables; test runners use isolated safe values.
# Infrastructure flags opt in to DB/queue/storage; their defaults remain disabled.
# Do not place secrets in NEXT_PUBLIC_* variables. Only the app name is approved.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Airmech One"

# API and worker default to 127.0.0.1:3001 and 127.0.0.1:3002 respectively.
# Override HOST/PORT per process; setting one PORT here applies to both Node apps.
# HOST=127.0.0.1
# PORT=3001
# ENV_FILE=/absolute/path/to/private-environment-file

DATABASE_ENABLED=false
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Runtime may use Supavisor transaction pooling (6543); migrations use direct/session (5432).
# DATABASE_MIGRATION_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# DATABASE_CA_FILE="/absolute/path/to/supabase-ca.pem"

REDIS_ENABLED=false
# REDIS_URL="redis://127.0.0.1:6379"

AUTH_ENABLED=false
# AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

STORAGE_ENABLED=false
# SUPABASE_URL="https://PROJECT.supabase.co"
# SUPABASE_ANON_KEY="REPLACE_WITH_PUBLIC_PROJECT_KEY"
# SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_PRIVATE_SERVICE_ROLE_KEY"
# STORAGE_BUCKET="private-documents"
# STORAGE_SECRET="REPLACE_WITH_PRIVATE_STORAGE_SECRET"

EMAIL_ENABLED=false
# EMAIL_API_KEY="REPLACE_WITH_PRIVATE_EMAIL_KEY"
# EMAIL_FROM="notifications@example.invalid"

OBSERVABILITY_ENABLED=false
OBSERVABILITY_SAMPLE_RATE=1
# OBSERVABILITY_ENDPOINT="https://telemetry.example.invalid"
# OBSERVABILITY_API_KEY="REPLACE_WITH_PRIVATE_OBSERVABILITY_KEY"

WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN="REPLACE_WITH_PRIVATE_WHATSAPP_TOKEN"

AI_ENABLED=false
# AI_API_KEY="REPLACE_WITH_PRIVATE_AI_KEY"
