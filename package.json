{
  "name": "airmech-one",
  "version": "0.1.0",
  "private": true,
  "description": "Airmech Operations Management System, built by Qeilvra",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev:web": "pnpm --filter @airmech/web dev",
    "dev:api": "pnpm --filter @airmech/api dev",
    "dev:worker": "pnpm --filter @airmech/worker dev",
    "build": "pnpm -r --sort run build",
    "build:packages": "pnpm --filter \"./packages/**\" --sort run build",
    "typecheck": "pnpm run build:packages && pnpm run typecheck:workspace",
    "typecheck:workspace": "pnpm -r --sort run typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:prepare": "pnpm run build:packages && pnpm --filter @airmech/api --filter @airmech/worker build",
    "test": "pnpm run test:prepare && pnpm run test:run",
    "test:run": "node --test tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test:unit": "pnpm run test:prepare && node --test tests/unit/*.test.cjs",
    "test:integration": "pnpm run test:prepare && node --test tests/integration/*.test.cjs",
    "test:smoke": "node --test tests/e2e/foundation.test.cjs",
    "test:browser": "node scripts/test-browser.cjs",
    "audit": "pnpm audit",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:verify": "node scripts/database.cjs verify",
    "db:seed": "node scripts/database.cjs seed",
    "test:live": "node --test tests/live/*.test.cjs",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run typecheck:workspace && pnpm run test:run && pnpm run test:smoke && pnpm run test:browser && pnpm run audit"
  },
  "devDependencies": {
    "@airmech/config": "workspace:*",
    "@airmech/contracts": "workspace:*",
    "@airmech/database": "workspace:*",
    "@airmech/queue": "workspace:*",
    "@airmech/storage": "workspace:*",
    "@airmech/testing": "workspace:*",
    "@airmech/ui": "workspace:*",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  }
}
