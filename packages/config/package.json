{
  "name": "@airmech/config",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": null,
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": null,
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.library.json": "./tsconfig.library.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./tsconfig.nextjs.json": "./tsconfig.nextjs.json",
    "./tsconfig.nestjs.json": "./tsconfig.nestjs.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "pnpm run build && node --test ../../tests/unit/runtime-settings.test.cjs ../../tests/unit/environment-config.test.cjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
