    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@airmech/config": "workspace:*",
    "@types/react": "19.3.0"
  }
